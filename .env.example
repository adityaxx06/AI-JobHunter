# Copy to .env — DO NOT commit real values. Never expose server secrets to the client.
#
# DATABASE_URL:
#   Used by the backend (and worker) to connect to PostgreSQL. This is the
#   primary database connection for all PostgreSQL operations.
# SUPABASE_URL:
#   Supabase project URL (project identifier for Supabase APIs).
# SUPABASE_ANON_KEY:
#   Public/client key. Safe to use from client-side contexts only for
#   non-privileged operations. Do NOT use it for privileged backend operations.
# SUPABASE_SERVICE_ROLE_KEY:
#   Privileged backend-only key (bypasses RLS). NEVER expose to the frontend,
#   never put it in NEXT_PUBLIC_* vars, never log it.
# GEMINI_API_KEY / GEMINI_MODEL:
#   Server-side only (Phase 6+). NEVER expose to the Next.js client.

# Backend
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8001

# Supabase (placeholders only — fill in local .env, never commit)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — Gemini is the planned primary provider (server-side only, Phase 6+)
GEMINI_API_KEY=
GEMINI_MODEL=

# Job intelligence (Phase 5.2 — free-first, everything off by default)
# AI_ENABLED:
#   Master switch for billable Gemini calls. Default false: zero AI traffic.
# AI_MAX_JOBS_PER_RUN:
#   Cap on Gemini calls per intelligence run (default 20).
# AI_REQUEST_TIMEOUT_SECONDS:
#   Per-request timeout for Gemini calls (default 30).
# RUN_INTELLIGENCE:
#   Worker flag enabling the intelligence stage (needs DB + AI_ENABLED + key).
AI_ENABLED=false
AI_MAX_JOBS_PER_RUN=20
AI_REQUEST_TIMEOUT_SECONDS=30
RUN_INTELLIGENCE=false

# Job ranking (Phase 5.3 — deterministic, zero AI calls, dynamic only)
# RUN_RANKING:
#   Worker flag enabling the ranking stage (needs DB + analyzed jobs).
#   Default off: normal discovery runs never rank.
# RANKING_DEFAULT_LIMIT:
#   Top-N served per ranking run (default 20). All valid jobs are scored
#   before the top-N cut — the database query never biases selection.
RUN_RANKING=false
RANKING_DEFAULT_LIMIT=20

# Discovery persistence (opt-in writes; default off = dry runs only)
# PERSIST_DISCOVERY:
#   Master switch for worker persistence writes. Default false: discovery,
#   ingestion, and demo runs only report what WOULD be persisted.
# ALLOW_MOCK_PERSIST:
#   Demo fixtures (source_name "mock") persist only with this set. Default
#   false: mock rows are never production data.
PERSIST_DISCOVERY=false
ALLOW_MOCK_PERSIST=false

# Greenhouse public job boards (Phase 4.2A — no API key needed, no secrets here)
# GREENHOUSE_ENABLED:
#   Set to true to let the worker fetch configured public boards.
#   Default (unset/false): source stays idle, pipeline remains healthy.
# GREENHOUSE_BOARDS:
#   Public board tokens separated by ";" (or ","), e.g. company-one;company-two.
#   A token is the public board identifier — safe to share, NOT a credential.
# GREENHOUSE_TIMEOUT:
#   Per-request seconds (default 10). GREENHOUSE_MAX_BOARDS caps board count (default 25).
GREENHOUSE_ENABLED=false
GREENHOUSE_BOARDS=
GREENHOUSE_TIMEOUT=10
GREENHOUSE_MAX_BOARDS=25

# Lever public postings (Phase 4.2B — no API key needed, no secrets here)
# LEVER_ENABLED:
#   Set to true to let the worker fetch configured public companies.
#   Default (unset/false): source stays idle, pipeline remains healthy.
# LEVER_BOARDS:
#   Public Lever company handles separated by ";" (or ","), e.g. acme;globex.
#   A handle is the public identifier in a company's Lever URL — NOT a credential.
# LEVER_TIMEOUT:
#   Per-request seconds (default 10). LEVER_MAX_BOARDS caps company count (default 10).
LEVER_ENABLED=false
LEVER_BOARDS=
LEVER_TIMEOUT=10
LEVER_MAX_BOARDS=10

# Ashby public job boards (Phase 4.2C — no API key needed, no secrets here)
# ASHBY_ENABLED:
#   Set to true to let the worker fetch configured public boards.
#   Default (unset/false): source stays idle, pipeline remains healthy.
# ASHBY_BOARDS:
#   Public Ashby board names separated by ";" (or ","), e.g. acme;globex.
#   A name is the public identifier in a company's Ashby board URL — NOT a credential.
#   Verified endpoint: GET https://api.ashbyhq.com/posting-api/job-board/{NAME}?includeCompensation=true
# ASHBY_TIMEOUT:
#   Per-request seconds (default 10). ASHBY_MAX_BOARDS caps board count (default 10).
ASHBY_ENABLED=false
ASHBY_BOARDS=
ASHBY_TIMEOUT=10
ASHBY_MAX_BOARDS=10

# Himalayas remote jobs (Phase 10C-2 — public API, no key, no secrets here)
# Docs: https://himalayas.app/docs/remote-jobs-api (free, no signup).
# Data refreshes ~daily; polling more than once a day gains nothing.
# Attribution: displayed jobs link back to their Himalayas applicationLink
# (kept as apply_url), and source_name stays "himalaya".
# HIMALAYA_ENABLED:
#   Set to true to let the worker query the public search endpoint.
#   Default (unset/false): source stays idle, pipeline remains healthy.
# HIMALAYA_KEYWORDS:
#   Search keywords separated by ";" (or ","), e.g. intern;software engineer.
#   Empty default: enabled source with no keywords stays idle. Max 5.
# HIMALAYA_EMPLOYMENT_TYPES:
#   Employment-type filter values (default "Intern"; empty disables filtering).
# HIMALAYA_TIMEOUT:
#   Per-request seconds (default 10).
HIMALAYA_ENABLED=false
HIMALAYA_KEYWORDS=
HIMALAYA_EMPLOYMENT_TYPES=Intern
HIMALAYA_TIMEOUT=10

# Search discovery (Phase 4.3 abstraction; mock default, Tavily opt-in 6.0)
# SEARCH_ENABLED / SEARCH_PROVIDER:
#   SEARCH_PROVIDER=mock (default, offline) or tavily (needs TAVILY_API_KEY).
#   A missing key with tavily selected is an explicit configuration error —
#   never a silent fallback.
# SEARCH_API_KEY:
#   Legacy generic placeholder (unused by Tavily/mock). NEVER commit a real
#   key, never log it, never expose it to the frontend.
# SEARCH_TIMEOUT / SEARCH_MAX_RESULTS:
#   Per-request seconds (default 10), per-query result cap (default 20, max 50).
SEARCH_ENABLED=false
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_TIMEOUT=10
SEARCH_MAX_RESULTS=20

# Tavily (Phase 6.0 — first real search provider; key required only to use it)
# Get a key: https://app.tavily.com (free tier ≈ 1,000 credits/mo, no card).
# TAVILY_API_KEY lives server-side ONLY — never NEXT_PUBLIC_*, never frontend
# files, never logs, never committed. Missing key = clean "not configured".
# TAVILY_SEARCH_DEPTH: basic (1 credit, default) or advanced (2 credits).
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIME_RANGE: optional best-effort recency hint (day/week/month/year).
#   Empty (default) = no date filtering, undated results kept. Invalid values
#   safely fall back to unset. Strict publication-date filtering is never
#   enabled: it would silently drop useful undated LinkedIn results. A set
#   range does NOT guarantee every result is newly posted or correctly dated.
#   Costs nothing extra; query budget unchanged.
TAVILY_TIME_RANGE=

# Controlled ATS ingestion (Phase 6.1 — dry run unless ALL persist gates pass)
# ENABLE_LIVE_INGESTION: second explicit opt-in for ingestion writes.
#   Writes happen ONLY when `--persist` is passed AND PERSIST_DISCOVERY=true
#   AND ENABLE_LIVE_INGESTION=true AND DATABASE_URL is set. Default false.
# MAX_INGESTION_QUERIES: Tavily queries per ingestion run (default 3, 1..10).
#   Each query spends Tavily credits — keep small during testing.
# MAX_INGESTION_BOARDS: distinct ATS boards fetched per run (default 5, 1..20).
ENABLE_LIVE_INGESTION=false
MAX_INGESTION_QUERIES=3
MAX_INGESTION_BOARDS=5
# MAX_INGESTION_JOBS_PER_BOARD: jobs taken per ATS board per run (default 50,
# 1..50). Lower for controlled samples (e.g. 10). Non-secret.
MAX_INGESTION_JOBS_PER_BOARD=50

# Automation / notifications (placeholders only)
NOTIFICATION_WEBHOOK_URL=
CRON_SCHEDULE=
